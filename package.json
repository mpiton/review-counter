    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.14",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "20.9.0",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "wxt": "0.20.26"
  },
  "packageManager": "pnpm@10.33.2"
