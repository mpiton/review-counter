    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "20.14.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@10.33.2"
